# Copy this file to `.env` and fill in real values for local testing.
# Never commit `.env` to version control.

# SMTP credentials (Gmail example shown)
SMTP_USERNAME=your_username@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_SENDER=your_username@gmail.com

# Comma-separated recipient list
ALERT_RECIPIENTS=alerts@example.com,oncall@example.com
